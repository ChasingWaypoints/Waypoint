+    glow.addColorStop(0, "rgba(12,30,41,0.95)"); glow.addColorStop(1, "rgba(10,10,10,0)");
+    ctx.fillStyle = glow; ctx.fillRect(0, 0, W, H);
+
+    // Brand: WP disc + WAY(white)POINT(lime) wordmark
