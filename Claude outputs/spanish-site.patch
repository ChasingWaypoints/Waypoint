+            <Link href="/" style={{ color: C.muted, textDecoration: "none" }}>English</Link>
+            <span style={{ color: C.body }}>Nunca vendemos tu ubicación. Jamás.</span>
+          </span>
+        </div>
+      </footer>
+    </main>
