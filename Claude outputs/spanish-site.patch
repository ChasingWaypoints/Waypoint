+        <div style={{ display: "flex", gap: 12, flexWrap: "wrap" }}>
+          <Link
+            href="/auth/signup"
+            style={{ background: C.lime, color: C.accentInk, fontWeight: 800, fontSize: text.lg, padding: "14px 26px", borderRadius: 4, textDecoration: "none", letterSpacing: 0.2 }}
