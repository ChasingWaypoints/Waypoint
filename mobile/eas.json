{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "../.secrets/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascApiKeyPath": "../.secrets/asc-api-key.p8",
        "ascApiKeyId": "REPLACE_KEY_ID",
        "ascApiKeyIssuerId": "REPLACE_ISSUER_ID",
        "appleTeamId": "REPLACE_TEAM_ID"
      }
    }
  }
}
