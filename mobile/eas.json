{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "../.secrets/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascApiKeyPath": "../.secrets/asc-api-key.p8",
        "_comment": "Key ID, Issuer ID and Team ID come from .secrets/ids.env via EXPO_ASC_* env vars \u2014 see scripts/with-apple-env.sh. Never commit them here; this repo is public."
      }
    }
  }
}
